APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# For container deployments (Render/Docker), set LOG_CHANNEL=stderr (or LOG_STACK=stderr) so errors output to container logs

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmt_print
DB_USERNAME=root
DB_PASSWORD=
# Optional SSL CA path for managed databases like Aiven (e.g. /etc/ssl/certs/ca-certificates.crt)
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PUBLIC_UPLOAD_DISK=public_uploads
PRIVATE_UPLOAD_DISK=private_uploads
PUBLIC_FILESYSTEM_DRIVER=local
PRIVATE_FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional public object storage for banners/products/categories/QRIS.
PUBLIC_AWS_ACCESS_KEY_ID=
PUBLIC_AWS_SECRET_ACCESS_KEY=
PUBLIC_AWS_DEFAULT_REGION=auto
PUBLIC_AWS_BUCKET=
PUBLIC_AWS_ENDPOINT=
PUBLIC_AWS_URL=
PUBLIC_AWS_USE_PATH_STYLE_ENDPOINT=true

# Optional private object storage for customer designs/payment proofs.
PRIVATE_AWS_ACCESS_KEY_ID=
PRIVATE_AWS_SECRET_ACCESS_KEY=
PRIVATE_AWS_DEFAULT_REGION=auto
PRIVATE_AWS_BUCKET=
PRIVATE_AWS_ENDPOINT=
PRIVATE_AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

DMT_ADMIN_NAME="Owner Admin"
DMT_ADMIN_EMAIL=owner@dmtprint.com
DMT_ADMIN_PASSWORD=
DMT_MAX_UPLOAD_KB=10240
DMT_ALLOWED_UPLOADS=jpg,jpeg,png,pdf,zip
